import React, { useState, useEffect, useRef } from 'react';
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  Alert,
  Linking,
  Animated,
  Vibration,
  SafeAreaView,
  Platform,
} from 'react-native';
import { CameraView, useCameraPermissions } from 'expo-camera';
import { MaterialCommunityIcons } from '@expo/vector-icons';

export default function QrOkuyucu({ isDarkMode, theme }) {
  const [permission, requestPermission] = useCameraPermissions();
  const [taranıyor, setTaranıyor] = useState(true);
  const [sonuc, setSonuc] = useState(null);
  const [flash, setFlash] = useState(false);
  const scanLineAnim = useRef(new Animated.Value(0)).current;
  const fadeAnim = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    if (taranıyor) {
      Animated.loop(
        Animated.sequence([
          Animated.timing(scanLineAnim, {
            toValue: 220,
            duration: 2000,
            useNativeDriver: true,
          }),
          Animated.timing(scanLineAnim, {
            toValue: 0,
            duration: 2000,
            useNativeDriver: true,
          }),
        ])
      ).start();
    } else {
      scanLineAnim.stopAnimation();
    }
  }, [taranıyor]);

  const handleBarCodeScanned = ({ data }) => {
    if (!taranıyor) return;
    setTaranıyor(false);
    setSonuc(data);
    Vibration.vibrate(200);
    fadeAnim.setValue(0);
    Animated.spring(fadeAnim, {
      toValue: 1,
      useNativeDriver: true,
      bounciness: 8,
    }).start();
  };

  const yenidenTara = () => {
    setSonuc(null);
    setTaranıyor(true);
    fadeAnim.setValue(0);
  };

  const kopyala = () => {
    // Clipboard deprecated olmadığı için manuel uyarı
    Alert.alert('Sonuç', sonuc, [
      { text: 'Tamam' }
    ]);
  };

  const baglantiAc = () => {
    const url =
      sonuc.startsWith('http://') || sonuc.startsWith('https://')
        ? sonuc
        : `https://${sonuc}`;
    Linking.openURL(url).catch(() =>
      Alert.alert('Hata', 'Bu bağlantı açılamadı.')
    );
  };

  const isURL =
    sonuc &&
    (sonuc.startsWith('http') ||
      sonuc.startsWith('www.') ||
      sonuc.includes('.com') ||
      sonuc.includes('.org') ||
      sonuc.includes('.net'));

  // İzin henüz yüklenmedi
  if (!permission) {
    return (
      <SafeAreaView style={[styles.centered, { backgroundColor: theme.colors.background }]}>
        <MaterialCommunityIcons name="camera-outline" size={48} color={theme.colors.secondary} />
        <Text style={[styles.bilgiText, { color: theme.colors.secondary }]}>
          Yükleniyor...
        </Text>
      </SafeAreaView>
    );
  }

  // İzin verilmedi
  if (!permission.granted) {
    return (
      <SafeAreaView style={[styles.centered, { backgroundColor: theme.colors.background }]}>
        <MaterialCommunityIcons name="camera-off" size={56} color="#ef4444" />
        <Text style={[styles.baslik, { color: theme.colors.text, marginTop: 16 }]}>
          Kamera İzni Gerekli
        </Text>
        <Text style={[styles.bilgiText, { color: theme.colors.secondary }]}>
          QR kod okumak için kamera izni ver.
        </Text>
        <TouchableOpacity
          style={[styles.buton, { backgroundColor: theme.colors.primary, marginTop: 20 }]}
          onPress={requestPermission}
        >
          <Text style={styles.butonText}>İzin Ver</Text>
        </TouchableOpacity>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={[styles.container, { backgroundColor: theme.colors.background }]}>
      {/* Kamera */}
      <View style={styles.kameraKapsayici}>
        <CameraView
          style={StyleSheet.absoluteFillObject}
          facing="back"
          enableTorch={flash}
          barcodeScannerSettings={{
            barcodeTypes: ['qr', 'ean13', 'ean8', 'code128'],
          }}
          onBarcodeScanned={taranıyor ? handleBarCodeScanned : undefined}
        />

        {/* Karartma */}
        <View style={styles.overlay}>
          <View style={[styles.overlayBolum, { backgroundColor: 'rgba(0,0,0,0.55)' }]} />
          <View style={styles.ortaSatir}>
            <View style={[styles.overlayYan, { backgroundColor: 'rgba(0,0,0,0.55)' }]} />
            <View style={styles.cerceve}>
              <View style={[styles.kose, styles.solUst, { borderColor: theme.colors.primary }]} />
              <View style={[styles.kose, styles.sagUst, { borderColor: theme.colors.primary }]} />
              <View style={[styles.kose, styles.solAlt, { borderColor: theme.colors.primary }]} />
              <View style={[styles.kose, styles.sagAlt, { borderColor: theme.colors.primary }]} />

              {taranıyor && (
                <Animated.View
                  style={[
                    styles.taramaCizgisi,
                    {
                      backgroundColor: theme.colors.primary,
                      transform: [{ translateY: scanLineAnim }],
                    },
                  ]}
                />
              )}

              {!taranıyor && (
                <View style={styles.basariIkon}>
                  <MaterialCommunityIcons name="check-circle" size={56} color="#22c55e" />
                </View>
              )}
            </View>
            <View style={[styles.overlayYan, { backgroundColor: 'rgba(0,0,0,0.55)' }]} />
          </View>
          <View style={[styles.overlayBolum, { backgroundColor: 'rgba(0,0,0,0.55)' }]} />
        </View>

        {/* Flash */}
        <TouchableOpacity
          style={[
            styles.flashButon,
            { backgroundColor: flash ? theme.colors.primary : 'rgba(0,0,0,0.5)' },
          ]}
          onPress={() => setFlash(!flash)}
        >
          <MaterialCommunityIcons
            name={flash ? 'flashlight' : 'flashlight-off'}
            size={22}
            color="#fff"
          />
        </TouchableOpacity>
      </View>

      {/* Alt alan */}
      <View style={[styles.altAlan, { backgroundColor: theme.colors.card }]}>
        {!sonuc ? (
          <View style={styles.centered}>
            <MaterialCommunityIcons name="qrcode-scan" size={28} color={theme.colors.secondary} />
            <Text style={[styles.ipucuText, { color: theme.colors.secondary }]}>
              QR kodu çerçeve içine hizala
            </Text>
            <Text style={[styles.ipucuAlt, { color: theme.colors.secondary }]}>
              Barkod ve QR kod desteklenir
            </Text>
          </View>
        ) : (
          <Animated.View style={{ opacity: fadeAnim, width: '100%' }}>
            <View
              style={[
                styles.sonucKart,
                {
                  backgroundColor: isDarkMode ? '#0f2027' : '#f0f9ff',
                  borderColor: theme.colors.primary,
                },
              ]}
            >
              <MaterialCommunityIcons name="qrcode-edit" size={20} color={theme.colors.primary} />
              <Text style={[styles.sonucBaslik, { color: theme.colors.primary }]}>Sonuç</Text>
              <Text
                style={[styles.sonucMetin, { color: theme.colors.text }]}
                numberOfLines={3}
              >
                {sonuc}
              </Text>
            </View>

            <View style={styles.butonlar}>
              <TouchableOpacity
                style={[styles.buton, { backgroundColor: theme.colors.primary, flex: 1, marginRight: 8 }]}
                onPress={kopyala}
              >
                <MaterialCommunityIcons name="information-outline" size={16} color="#fff" />
                <Text style={styles.butonText}>Göster</Text>
              </TouchableOpacity>

              {isURL && (
                <TouchableOpacity
                  style={[styles.buton, { backgroundColor: '#22c55e', flex: 1, marginRight: 8 }]}
                  onPress={baglantiAc}
                >
                  <MaterialCommunityIcons name="open-in-new" size={16} color="#fff" />
                  <Text style={styles.butonText}>Aç</Text>
                </TouchableOpacity>
              )}

              <TouchableOpacity
                style={[
                  styles.buton,
                  { backgroundColor: isDarkMode ? '#334155' : '#e2e8f0', flex: 1 },
                ]}
                onPress={yenidenTara}
              >
                <MaterialCommunityIcons name="qrcode-scan" size={16} color={theme.colors.text} />
                <Text style={[styles.butonText, { color: theme.colors.text }]}>Yeniden</Text>
              </TouchableOpacity>
            </View>
          </Animated.View>
        )}
      </View>
    </SafeAreaView>
  );
}

